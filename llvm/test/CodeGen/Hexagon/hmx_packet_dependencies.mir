# RUN: llc -mtriple=hexagon -mcpu=hexagonv73 -mattr=+hmx -run-pass=hexagon-packetizer %s -o - | FileCheck %s
# RUN: llc -mtriple=hexagon -mcpu=hexagonv75 -mattr=+hmx -run-pass=hexagon-packetizer %s -o - | FileCheck %s
# RUN: llc -mtriple=hexagon -mcpu=hexagonv79 -mattr=+hmx -run-pass=hexagon-packetizer %s -o - | FileCheck %s
#
# Weight insertion bypasses normal per-instruction dependence checks. A weight
# address or Rt producer must complete before the mandatory act/weight packet.
# Physical super-register definitions alias their low/high register reads.
# Independent ALU work can still share the pair's packet.
---
name: weight_address_raw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r8, $r31
    $r4 = A2_addi $r2, 2048
    $r6 = A2_addi $r2, 6144
    M8_mxmem_blk_sm_act_hf $r0, $r1
    M8_mxmem_wei_hf $r4, $r8
    PS_jmpret $r31, implicit-def dead $pc
...
# CHECK-LABEL: name: weight_address_raw
# CHECK: $r4 = A2_addi
# CHECK: $r6 = A2_addi
# CHECK: BUNDLE
# CHECK-NEXT: M8_mxmem_blk_sm_act_hf
# CHECK-NEXT: M8_mxmem_wei_hf
# CHECK-NEXT: }
---
name: weight_rt_raw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r31
    $r8 = A2_addi $r2, 1920
    M8_mxmem_blk_sm_act_hf $r0, $r1
    M8_mxmem_wei_hf $r3, $r8
    PS_jmpret $r31, implicit-def dead $pc
...
# CHECK-LABEL: name: weight_rt_raw
# CHECK: $r8 = A2_addi
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: M8_mxmem_blk_sm_act_hf
# CHECK-NEXT: M8_mxmem_wei_hf
# CHECK-NEXT: }
---
name: weight_superregister_raw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r8, $r31
    $d2 = A2_combinew $r2, $r3
    M8_mxmem_blk_sm_act_hf $r0, $r1
    M8_mxmem_wei_hf $r4, $r8
    PS_jmpret $r31, implicit-def dead $pc
...
# CHECK-LABEL: name: weight_superregister_raw
# CHECK: $d2 = A2_combinew
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: M8_mxmem_blk_sm_act_hf
# CHECK-NEXT: M8_mxmem_wei_hf
# CHECK-NEXT: }
---
name: independent_alu_shares_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r8, $r31
    $r6 = A2_addi $r2, 2048
    M8_mxmem_blk_sm_act_hf $r0, $r1
    M8_mxmem_wei_hf $r4, $r8
    PS_jmpret $r31, implicit-def dead $pc
...
# CHECK-LABEL: name: independent_alu_shares_pair
# CHECK: BUNDLE
# CHECK-NEXT: $r6 = A2_addi
# CHECK-NEXT: M8_mxmem_blk_sm_act_hf
# CHECK-NEXT: M8_mxmem_wei_hf
# CHECK-NEXT: }
---
name: integer_weight_raw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r8, $r31
    $r4 = A2_addi $r2, 1024
    M8_mxmem_blk_sm_act_ub $r0, $r1
    M8_mxmem_wei_b $r4, $r8
    PS_jmpret $r31, implicit-def dead $pc
...
# CHECK-LABEL: name: integer_weight_raw
# CHECK: $r4 = A2_addi
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: M8_mxmem_blk_sm_act_ub
# CHECK-NEXT: M8_mxmem_wei_b
# CHECK-NEXT: }
---
name: weight_implicit_raw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r31
    $r8 = A2_addi $r2, 1920
    M8_mxmem_blk_sm_act_hf $r0, $r1
    M8_mxmem_wei_hf $r3, $r4, implicit $r8
    PS_jmpret $r31, implicit-def dead $pc
...
# CHECK-LABEL: name: weight_implicit_raw
# CHECK: $r8 = A2_addi
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: M8_mxmem_blk_sm_act_hf
# CHECK-NEXT: M8_mxmem_wei_hf
# CHECK-NEXT: }
---
name: weight_implicit_waw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r31
    $r8 = A2_addi $r2, 1920
    M8_mxmem_blk_sm_act_hf $r0, $r1
    M8_mxmem_wei_hf $r3, $r4, implicit-def $r8
    PS_jmpret $r31, implicit-def dead $pc
...
# CHECK-LABEL: name: weight_implicit_waw
# CHECK: $r8 = A2_addi
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: M8_mxmem_blk_sm_act_hf
# CHECK-NEXT: M8_mxmem_wei_hf
# CHECK-NEXT: }
